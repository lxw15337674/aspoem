{
  "name": "basic-template",
  "type": "module",
  "version": "next-beta.2",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "imports": {
    "#globals.css": "./src/styles/globals.css"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=10.15.1"
  },
  "scripts": {
    "build": "vinext build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aspoem --local",
    "db:migrate": "wrangler d1 migrations apply aspoem --remote",
    "db:studio": "drizzle-kit studio",
    "dev": "vinext dev --port 3001",
    "preview": "vinext build && wrangler dev --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "format:db": "NODE_OPTIONS=--experimental-sqlite tsx scripts/format-db/index.ts",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "gen:markdown": "tsx scripts/chinese-poetry-to-markdown/index.ts",
    "gen:db": "NODE_OPTIONS=--experimental-sqlite tsx scripts/poems-to-db/index.ts",
    "ui:upgrade": "for file in src/components/ui/*.tsx; do npx shadcn@latest add -y -o $(basename \"$file\" .tsx); done",
    "prepare": "husky",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "^16.0.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vinext/cloudflare": "1.0.0-beta.1",
    "axios": "^1.13.2",
    "better-auth": "^1.3.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.5",
    "gray-matter": "^4.0.3",
    "jotai": "^2.15.1",
    "lucide-react": "^0.544.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.5",
    "opencc-js": "^1.0.5",
    "pinyin-pro": "^3.27.0",
    "react": "19.2.7",
    "react-day-picker": "^9.12.0",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.62.0",
    "react-server-dom-webpack": "^19.2.7",
    "server-only": "^0.0.1",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "usehooks-ts": "^3.1.1",
    "vinext": "1.0.0-beta.1",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.11",
    "@biomejs/biome": "2.3.3",
    "@cloudflare/vite-plugin": "^1.45.0",
    "@iconify/react": "^6.0.2",
    "@pinyin-pro/data": "^1.2.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@tailwindcss/typography": "^0.5.19",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.10",
    "@types/opencc-js": "^1.0.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.27",
    "drizzle-kit": "^0.30.6",
    "fs-extra": "^11.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pangu": "^7.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.8.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.1.4",
    "wrangler": "^4.111.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    }
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  }
}
